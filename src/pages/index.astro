---
import Base from '../layouts/Base.astro';
import ApartmentCard from '../components/ApartmentCard.astro';
import Faq from '../components/Faq.astro';
import { APARTMENTS } from '../data/apartments';
import { IMG } from '../data/images';
import { SITE } from '../data/site';
import { FAQ_HOME } from '../data/faqs';

const homeSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: SITE.name,
  description: SITE.description,
  url: SITE.url,
};
---

<Base
  title="Vakantieappartement huren in Ehrwald — direct van de Nederlandse eigenaar"
  description="Vier 4-persoons vakantieappartementen in Ehrwald, Tirol, vlak onder de Zugspitze. Persoonlijk verhuurd door de familie Hanegraaf — geen tussenpersoon, geen boekingscommissie."
  path="/"
  image={IMG.heroChalet}
  schema={homeSchema}
  transparentHeader
>
  <section class="relative min-h-[92vh] flex items-end overflow-hidden">
    <img
      src={IMG.heroChalet}
      alt="Bruin houten chalet in Tirol met de besneeuwde Zugspitze op de achtergrond — Haus Stefanie Ehrwald"
      class="absolute inset-0 w-full h-full object-cover"
      width="2000"
      height="1333"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/20 to-black/70"></div>

    <div class="relative max-w-7xl mx-auto px-6 pb-20 md:pb-28 text-white">
      <div class="text-xs uppercase tracking-[0.3em] mb-4 opacity-90">
        Sinds 2008 · Ehrwald, Tirol
      </div>
      <h1 class="font-display text-5xl md:text-7xl lg:text-8xl leading-[0.95] max-w-4xl drop-shadow-lg">
        Vier appartementen,<br />
        <span class="italic">één familie,</span><br />
        vlak onder de Zugspitze.
      </h1>
      <p class="mt-6 text-lg md:text-xl max-w-2xl opacity-95 drop-shadow">
        Haus Stefanie verhuurt vier 4-persoons vakantieappartementen in Ehrwald — direct van de Nederlandse eigenaars. Geen tussenpersoon, geen commissie, gewoon persoonlijk contact.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#appartementen" class="bg-[var(--color-tirol)] hover:bg-[var(--color-tirol-dark)] text-white px-7 py-3.5 rounded-full font-medium transition-colors">
          Bekijk de appartementen
        </a>
        <a href="/ehrwald" class="bg-white/10 backdrop-blur border border-white/30 hover:bg-white/20 text-white px-7 py-3.5 rounded-full font-medium transition-colors">
          Over Ehrwald
        </a>
      </div>
    </div>
  </section>

  <section class="bg-[var(--color-cream-dark)] border-y border-[var(--color-mist)]">
    <div class="max-w-7xl mx-auto px-6 py-10 grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
      {[
        { num: '4', label: '4-persoons appartementen' },
        { num: '0%', label: 'boekingscommissie' },
        { num: 'NL', label: 'eigenaars, persoonlijk contact' },
        { num: '850 km', label: 'rijden vanaf Utrecht' },
      ].map((item) => (
        <div>
          <div class="font-display text-4xl md:text-5xl text-[var(--color-tirol)]">
            {item.num}
          </div>
          <div class="mt-1 text-xs uppercase tracking-widest text-[var(--color-stone)]">
            {item.label}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-6 py-20 text-center">
    <div class="text-xs uppercase tracking-[0.3em] text-[var(--color-tirol)] mb-4">
      Welkom bij Haus Stefanie
    </div>
    <h2 class="font-display text-4xl md:text-5xl mb-6">
      Een huis dat al drie generaties in onze familie zit.
    </h2>
    <p class="text-lg leading-relaxed text-[var(--color-stone)]">
      Oma Liesl bouwde Haus Stefanie ooit op een rustige plek net buiten het centrum van Ehrwald. Vandaag verhuren we als familie de vier appartementen aan gasten die — net als wij — verliefd zijn geworden op dit hoekje van Tirol. Geen receptie, geen sterren­classificatie. Wel: een sleutel, een persoonlijke welkom, en de bergen voor je deur.
    </p>
  </section>

  <section id="appartementen" class="bg-[var(--color-cream)] py-20 scroll-mt-20">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex items-end justify-between flex-wrap gap-6 mb-12">
        <div>
          <div class="text-xs uppercase tracking-[0.3em] text-[var(--color-tirol)] mb-3">De appartementen</div>
          <h2 class="font-display text-4xl md:text-5xl max-w-2xl">Vier units, allemaal voor 4 personen.</h2>
        </div>
        <p class="max-w-md text-[var(--color-stone)]">
          Elk appartement heeft zijn eigen karakter en eigen eigenaar. Klik door voor foto's, voorzieningen, prijzen en directe aanvraag.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {APARTMENTS.map((apt) => <ApartmentCard apt={apt} />)}
      </div>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-6 py-20 grid md:grid-cols-2 gap-6">
    <a href="/winter" class="group relative aspect-[4/3] rounded-2xl overflow-hidden">
      <img src={IMG.snowMountain} alt="Wintersport in Ehrwald, Zugspitz Arena" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy" />
      <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent"></div>
      <div class="absolute bottom-0 left-0 right-0 p-8 text-white">
        <div class="text-xs uppercase tracking-[0.3em] opacity-80 mb-2">December – April</div>
        <h3 class="font-display text-3xl md:text-4xl mb-2">Sneeuwzeker, dankzij de Zugspitze</h3>
        <p class="text-sm opacity-90 max-w-md">
          Ski-in op vijf gebieden, gletscherski tot ver in het voorjaar, en een dorp dat nooit overrompeld voelt.
        </p>
        <span class="inline-block mt-4 text-sm underline underline-offset-4">Lees meer over winter →</span>
      </div>
    </a>
    <a href="/zomer" class="group relative aspect-[4/3] rounded-2xl overflow-hidden">
      <img src={IMG.alpsFlowers} alt="Zomerwandelen in Tirol" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy" />
      <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent"></div>
      <div class="absolute bottom-0 left-0 right-0 p-8 text-white">
        <div class="text-xs uppercase tracking-[0.3em] opacity-80 mb-2">Mei – Oktober</div>
        <h3 class="font-display text-3xl md:text-4xl mb-2">Wandelparadijs in groen Tirol</h3>
        <p class="text-sm opacity-90 max-w-md">
          Honderden kilometers gemarkeerde routes, koele bergmeren en kabelbanen die zomers gewoon doordraaien.
        </p>
        <span class="inline-block mt-4 text-sm underline underline-offset-4">Lees meer over zomer →</span>
      </div>
    </a>
  </section>

  <section class="bg-[var(--color-wood)] text-[var(--color-cream)] py-20">
    <div class="max-w-7xl mx-auto px-6 grid md:grid-cols-2 gap-12 items-center">
      <div>
        <div class="text-xs uppercase tracking-[0.3em] text-[var(--color-tirol)] opacity-90 mb-3">De locatie</div>
        <h2 class="font-display text-4xl md:text-5xl mb-6 text-white">Net buiten het centrum, vlak onder de berg.</h2>
        <p class="opacity-90 leading-relaxed mb-4">
          Haus Stefanie ligt aan een rustige weg op vijf minuten lopen van het centrum van Ehrwald — dichtbij genoeg voor een avondje uit, ver genoeg voor stilte 's nachts. De skiliften en de Ehrwalder Almbahn liggen op een paar minuten rijden.
        </p>
        <address class="not-italic opacity-90 mb-6">
          {SITE.address.street}<br />
          {SITE.address.postalCode} {SITE.address.city}, {SITE.address.region}
        </address>
        <a
          href={`https://www.google.com/maps/search/?api=1&query=${SITE.address.lat},${SITE.address.lng}`}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 bg-white text-[var(--color-wood)] px-6 py-3 rounded-full font-medium hover:bg-[var(--color-cream-dark)] transition-colors"
        >
          Open in Google Maps →
        </a>
      </div>
      <div class="aspect-[4/3] rounded-2xl overflow-hidden">
        <img src={IMG.villageAerial} alt="Ehrwald dorp in Tirol vanuit de lucht" class="w-full h-full object-cover" loading="lazy" />
      </div>
    </div>
  </section>

  <Faq items={FAQ_HOME} title="De vragen die we het vaakst krijgen" />
</Base>
