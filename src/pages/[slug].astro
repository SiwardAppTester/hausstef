---
import Base from '../layouts/Base.astro';
import InquiryForm from '../components/InquiryForm.astro';
import Faq from '../components/Faq.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { APARTMENTS, PRICING_TABLE_2026, PRICING_NOTES } from '../data/apartments';
import { IMG } from '../data/images';
import { SITE } from '../data/site';
import { FAQ_APARTMENT } from '../data/faqs';

export async function getStaticPaths() {
  return APARTMENTS.map((apt) => ({ params: { slug: apt.slug }, props: { apt } }));
}

const { apt } = Astro.props;

const aptSchema = {
  '@context': 'https://schema.org',
  '@type': 'Apartment',
  name: `${apt.name} — ${SITE.name}`,
  description: apt.description,
  url: `${SITE.url}/${apt.slug}`,
  image: IMG[apt.hero],
  numberOfRooms: apt.bedrooms,
  occupancy: { '@type': 'QuantitativeValue', maxValue: apt.capacity },
  floorSize: { '@type': 'QuantitativeValue', value: apt.size },
  amenityFeature: apt.features.map((f) => ({
    '@type': 'LocationFeatureSpecification',
    name: f,
    value: true,
  })),
  offers: {
    '@type': 'Offer',
    priceCurrency: 'EUR',
    price: apt.priceFrom,
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: apt.priceFrom,
      priceCurrency: 'EUR',
      unitText: 'WEEK',
    },
    availability: 'https://schema.org/InStock',
  },
  containedInPlace: {
    '@type': 'LodgingBusiness',
    name: SITE.name,
    address: {
      '@type': 'PostalAddress',
      streetAddress: SITE.address.street,
      postalCode: SITE.address.postalCode,
      addressLocality: SITE.address.city,
      addressRegion: SITE.address.region,
      addressCountry: SITE.address.country,
    },
  },
};
---

<Base
  title={`${apt.name} huren in Ehrwald — 4 personen, vlak onder de Zugspitze`}
  description={`${apt.tagline}. ${apt.size}, ${apt.bedrooms} slaapkamers, geschikt voor ${apt.capacity} personen. Vanaf € ${apt.priceFrom} per week. Direct van de eigenaar.`}
  path={`/${apt.slug}`}
  image={IMG[apt.hero]}
  schema={aptSchema}
  transparentHeader
>
  <!-- HERO -->
  <section class="relative min-h-[70vh] flex items-end overflow-hidden">
    <img src={IMG[apt.hero]} alt={`${apt.name} bij Haus Stefanie in Ehrwald — ${apt.tagline}`} class="absolute inset-0 w-full h-full object-cover" width="1600" height="1067" fetchpriority="high" />
    <div class="absolute inset-0 bg-gradient-to-b from-black/30 via-transparent to-black/70"></div>
    <div class="relative max-w-7xl mx-auto px-6 pb-16 text-white">
      <a href="/#appartementen" class="text-sm opacity-90 hover:opacity-100 underline underline-offset-4">← Alle appartementen</a>
      <h1 class="mt-3 font-display text-5xl md:text-7xl drop-shadow-lg">{apt.name}</h1>
      <p class="mt-3 text-lg md:text-xl max-w-2xl opacity-95 drop-shadow">{apt.tagline}</p>
      <div class="mt-6 flex flex-wrap gap-2 text-sm">
        <span class="bg-white/15 backdrop-blur border border-white/30 px-4 py-1.5 rounded-full">{apt.capacity} personen</span>
        <span class="bg-white/15 backdrop-blur border border-white/30 px-4 py-1.5 rounded-full">{apt.bedrooms} slaapkamers</span>
        <span class="bg-white/15 backdrop-blur border border-white/30 px-4 py-1.5 rounded-full">{apt.size}</span>
        <span class="bg-[var(--color-tirol)] text-white px-4 py-1.5 rounded-full">vanaf € {apt.priceFrom}/week</span>
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-6 pt-6">
    <Breadcrumbs trail={[
      { label: 'Home', href: '/' },
      { label: 'Appartementen', href: '/#appartementen' },
      { label: apt.name },
    ]} />
  </div>

  <!-- BODY -->
  <section class="max-w-7xl mx-auto px-6 py-12 grid lg:grid-cols-3 gap-12">
    <div class="lg:col-span-2 space-y-12">
      <!-- description -->
      <div>
        <div class="text-xs uppercase tracking-[0.3em] text-[var(--color-tirol)] mb-3">Over dit appartement</div>
        <h2 class="font-display text-3xl md:text-4xl mb-4">{apt.tagline}</h2>
        <p class="text-lg text-[var(--color-stone)] leading-relaxed">{apt.description}</p>
      </div>

      <!-- gallery -->
      <div class="grid grid-cols-2 gap-3">
        {apt.gallery.map((key, i) => (
          <div class:list={[
            'overflow-hidden rounded-xl bg-[var(--color-mist)]',
            i === 0 && 'col-span-2 aspect-[16/9]',
            i !== 0 && 'aspect-[4/3]',
          ]}>
            <img src={IMG[key]} alt={`${apt.name} in Ehrwald — impressie ${i + 1}`} loading="lazy" width="1600" height={i === 0 ? 900 : 1200} class="w-full h-full object-cover hover:scale-105 transition-transform duration-700" />
          </div>
        ))}
      </div>

      <!-- features -->
      <div>
        <h2 class="font-display text-3xl mb-6">Wat is er allemaal?</h2>
        <ul class="grid sm:grid-cols-2 gap-3">
          {apt.features.map((f) => (
            <li class="flex items-start gap-3 bg-white p-4 rounded-lg border border-[var(--color-mist)]">
              <span class="text-[var(--color-tirol)] mt-0.5">✓</span>
              <span class="text-sm">{f}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- pricing -->
      <div>
        <h2 class="font-display text-3xl mb-2">Prijzen 2026</h2>
        <p class="text-sm text-[var(--color-stone)] mb-6">Per week, voor 4 personen, alles inbegrepen behalve toeristenbelasting.</p>
        <div class="bg-white rounded-2xl border border-[var(--color-mist)] overflow-hidden">
          <table class="w-full text-sm">
            <thead class="bg-[var(--color-cream-dark)] text-left">
              <tr>
                <th class="px-4 py-3 font-medium">Periode</th>
                <th class="px-4 py-3 font-medium text-right">Prijs / week</th>
              </tr>
            </thead>
            <tbody>
              {PRICING_TABLE_2026.map((row, i) => (
                <tr class:list={['border-t border-[var(--color-mist)]', i % 2 === 1 && 'bg-[var(--color-cream)]/40']}>
                  <td class="px-4 py-3">{row.period}</td>
                  <td class="px-4 py-3 text-right font-display text-lg">€ {row.price}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <ul class="mt-4 text-xs text-[var(--color-stone)] space-y-1">
          {PRICING_NOTES.map((n) => <li>· {n}</li>)}
        </ul>
      </div>
    </div>

    <!-- sticky sidebar -->
    <aside class="lg:sticky lg:top-8 lg:self-start space-y-6">
      <div class="bg-[var(--color-cream-dark)] rounded-2xl p-6">
        <div class="text-xs uppercase tracking-widest text-[var(--color-stone)] mb-2">Eigenaar</div>
        <div class="font-display text-xl mb-1">{apt.owner.name}</div>
        <a href={`tel:${apt.owner.phone.replace(/\s/g, '')}`} class="block text-sm text-[var(--color-tirol)] hover:underline">
          {apt.owner.phone}
        </a>
      </div>
      <InquiryForm apartmentName={apt.name} ownerEmail={apt.owner.email} ownerPhone={apt.owner.phone} />
    </aside>
  </section>

  <Faq items={FAQ_APARTMENT} title={`Vragen over ${apt.name}`} />
</Base>
