---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

type Props = {
  title: string;
  description: string;
  path?: string;
  image?: string;
  type?: 'website' | 'article';
  schema?: Record<string, unknown> | Record<string, unknown>[];
  transparentHeader?: boolean;
};

const { transparentHeader = false, ...seoProps } = Astro.props;
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://images.unsplash.com" />
    <link rel="preconnect" href="https://fonts.bunny.net" />
    <link
      rel="stylesheet"
      href="https://fonts.bunny.net/css?family=cormorant-garamond:500,600|inter:400,500,600&display=swap"
    />
    <meta name="theme-color" content="#c8102e" />
    <SEO {...seoProps} />
  </head>
  <body class="min-h-screen flex flex-col bg-[var(--color-cream)]">
    {!transparentHeader && <div class="bg-[var(--color-wood)] h-20" />}
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
