---
import { SITE, NAV } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="bg-[var(--color-wood)] text-[var(--color-cream)] mt-24">
  <div class="max-w-7xl mx-auto px-6 py-16 grid md:grid-cols-3 gap-12">
    <div>
      <div class="font-display text-2xl mb-3">{SITE.name}</div>
      <p class="text-sm opacity-80 leading-relaxed">
        Vier vakantie­appartementen in Ehrwald, Tirol — direct verhuurd door de Nederlandse familie Hanegraaf. Geen tussenpersoon, geen commissie.
      </p>
    </div>

    <div>
      <div class="text-xs uppercase tracking-widest opacity-60 mb-3">Navigatie</div>
      <ul class="space-y-2 text-sm">
        {NAV.map((item) => (
          <li><a href={item.href} class="hover:text-white transition-colors">{item.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <div class="text-xs uppercase tracking-widest opacity-60 mb-3">Adres</div>
      <address class="not-italic text-sm leading-relaxed opacity-90">
        {SITE.address.street}<br />
        {SITE.address.postalCode} {SITE.address.city}<br />
        {SITE.address.region}, Oostenrijk
      </address>
      <a
        href={`https://www.google.com/maps/search/?api=1&query=${SITE.address.lat},${SITE.address.lng}`}
        target="_blank"
        rel="noopener"
        class="inline-block mt-3 text-sm text-[var(--color-cream)] underline underline-offset-4 opacity-90 hover:opacity-100"
      >
        Bekijk op kaart →
      </a>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="max-w-7xl mx-auto px-6 py-6 text-xs opacity-60 flex flex-wrap justify-between gap-4">
      <div>© {year} {SITE.name}. Alle rechten voorbehouden.</div>
      <div>Een familieproject — geen boekingsplatform, geen tussenpersoon.</div>
    </div>
  </div>
</footer>
